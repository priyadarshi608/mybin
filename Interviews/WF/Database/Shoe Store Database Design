Get revenue we made last month.

------------------------------------------------------------------------------------

SELECT SUM(td.subTotalAmount) AS revenue_last_month
FROM Transactions t
WHERE 
MONTH(t.TransactionTimestamp) = MONTH(CURRENT_DATE - INTERVAL 1 MONTH)
AND YEAR(t.TransactionTimestamp) = YEAR(CURRENT_DATE - INTERVAL 1 MONTH);

====================================================================================

Get all shoes (ids) with count how many we sold last month.

------------------------------------------------------------------------------------

SELECT 
    td.ShoeID,
    sum(td.quantity) AS sold_count_last_month
FROM 
    TransactionDetails td
JOIN 
    Transactions t ON td.TransactionID = t.TransactionID
WHERE 
    MONTH(t.TransactionTimestamp) = MONTH(CURRENT_DATE - INTERVAL 1 MONTH)
    AND YEAR(t.TransactionTimestamp) = YEAR(CURRENT_DATE - INTERVAL 1 MONTH)
GROUP BY 
    td.ShoeID;

====================================================================================

Get all shoes (ids) that were not sold last month.

------------------------------------------------------------------------------------

SELECT 
    s.id AS ShoeID
FROM 
    Shoe s
WHERE 
    s.id NOT IN (
        SELECT DISTINCT 
            td.ShoeID
        FROM 
            TransactionDetails td
        JOIN 
            Transactions t ON td.TransactionID = t.TransactionID
        WHERE 
            MONTH(t.TransactionTimestamp) = MONTH(CURRENT_DATE - INTERVAL 1 MONTH)
            AND YEAR(t.TransactionTimestamp) = YEAR(CURRENT_DATE - INTERVAL 1 MONTH)
    );

====================================================================================

Select top 10 shoes that were sold in last 3 months more than 100 times.

------------------------------------------------------------------------------------

SELECT 
    td.ShoeID,
    COUNT(*) AS sold_count_last_3_months
FROM 
    TransactionDetails td
JOIN 
    Transactions t ON td.TransactionID = t.TransactionID
WHERE 
    t.TransactionTimestamp >= (CURRENT_DATE - INTERVAL 3 MONTH)
GROUP BY 
    td.ShoeID
HAVING 
    sold_count_last_3_months > 100
ORDER BY 
    sold_count_last_3_months DESC
LIMIT 10;

