What is the price of Adidas, black, size 46?

------------------------------------------------------------------------------------

SELECT price
FROM Shoe
WHERE brandId = (SELECT id FROM Brand WHERE name = 'Adidas')
  AND colorId = (SELECT id FROM Color WHERE name = 'black')
  AND sizeId = (SELECT id FROM Size WHERE name = 46);

====================================================================================

Is Adidas, black, size 46 available?

------------------------------------------------------------------------------------

SELECT S.id
FROM Shoe AS S
JOIN Inventory AS I ON S.id = I.shoeId
WHERE S.brandId = (SELECT id FROM Brand WHERE name = 'Adidas')
  AND S.colorId = (SELECT id FROM Color WHERE name = 'black')
  AND S.sizeId = (SELECT id FROM Size WHERE name = 46)
  AND I.stock > 0;

