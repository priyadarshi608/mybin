-- 1.) Fetch all employees that have a salary higher than 25000

-- 2.) Get the number of employees in department 2

-- 3.) Calculate the total salary cost for the company and return the minimum and maximum salary in the same query

-- 4.) Write a query to list all department_ids that have employees, let the IDs be unique.

-- 5.) Get the department_ids of all departments that have at least 2 employees.

-- 6.) Get the title of the project that has the most employees assigned to it.

-- 7.) Fetch the names of the employees that are not assigned to a department.

-- 8.) Sometimes employees do not enter a first_name when they register. Rewrite your query from 7.) to use the last_name as first_name in case the first_name is NULL.

-- 9.) Write a query that returns a count of all employees with salary < 50000, aggregated by 10000 increments. For example, 1 from 0-10000, 2 from 10000-20000, etc.

-- 10.) Write a query that returns a list of all department names that do not have any employees.

-- 11.) Write a query that returns the count of projects that employees worked on in 2011.

-- 12.) Write a query to print employee_id, project_id and projects_count for all the employees who worked on any project in 2011. Also include those employees who didn't work on any project in 2011 but with count 0.

------------------------------------------------------------------------------------

1. select * from employees where salary > 25000;
2. select * from employees where department_id = 2;
3. select sum(salary), max(salary), min(salary) from employees;
4. select distinct(department_id) from employees where department_id is not null;
5. SELECT department_id FROM employees GROUP BY department_id HAVING COUNT(*) >= 2;
6. SELECT p.title FROM projects p JOIN employees_projects ep ON p.id = ep.project_id GROUP BY p.id ORDER BY COUNT(ep.employee_id) DESC LIMIT 1;
7. SELECT CONCAT(first_name, ' ', last_name) AS employee_name FROM employees WHERE department_id IS NULL;
8. SELECT CONCAT(COALESCE(first_name, last_name), ' ', last_name) AS employee_name FROM employees WHERE department_id IS NULL;
9. SELECT FLOOR(e.salary / 10000) * 10000 as salary_range, COUNT(*) as employee_count FROM employees e WHERE salary < 50000 GROUP BY salary_range ORDER BY salary_range;
10. SELECT d.name AS department_name FROM departments d LEFT JOIN employees e ON d.id = e.department_id WHERE e.id IS NULL;
11. SELECT COUNT(DISTINCT ep.project_id) AS projects_count FROM employees_projects ep JOIN projects p ON ep.project_id = p.id WHERE YEAR(p.start_date) = 2011;
12. SELECT e.id AS employee_id, p.id AS project_id, COUNT(DISTINCT p.id) AS projects_count FROM employees e LEFT JOIN employees_projects ep ON e.id = ep.employee_id LEFT JOIN projects p ON ep.project_id = p.id AND YEAR(p.start_date) = 2011 GROUP BY e.id, p.id ORDER BY e.id, p.id;

