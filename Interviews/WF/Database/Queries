CREATE TABLE `tblPriceType` (
  `Id` int NOT NULL,
  `Name` varchar(64) NOT NULL,
  PRIMARY KEY (`Id`)
);

CREATE TABLE `tblProductPrice` (
  `Id` int NOT NULL AUTO_INCREMENT,
  `ProductName` varchar(64) NOT NULL,
  `PriceTypeId` int NOT NULL,
  `PriceValue` decimal(19,4) NOT NULL,
  PRIMARY KEY (`Id`),
  KEY `PriceTypeId` (`PriceTypeId`),
  CONSTRAINT `tblProductPrice_ibfk_1` FOREIGN KEY (`PriceTypeId`) REFERENCES `tblPriceType` (`Id`)
);

